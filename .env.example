# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# DeepSeek API
DEEPSEEK_API_KEY=replace-me

# Auth.js / NextAuth.js
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes

# Guards the internal cron endpoint (optional; Vercel Cron sets x-vercel-cron header)
CRON_SECRET=replace-with-a-random-string

# Distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
# Single-instance self-hosting only: allow the in-memory limiter in production.
# Leave unset on serverless/multi-instance deployments.
# RATE_LIMIT_ALLOW_IN_MEMORY=1

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Cloudflare R2 (S3-compatible object storage)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=daily-speech-practice

# Speech-to-text — 任意 OpenAI 兼容的 audio/transcriptions 服务
# OpenAI:        base https://api.openai.com/v1        model gpt-4o-mini-transcribe  extras=1
# Groq(免费):    base https://api.groq.com/openai/v1    model whisper-large-v3        extras=0
# 硅基流动:      base https://api.siliconflow.cn/v1     model 见其文档                extras=0
TRANSCRIPTION_API_KEY=replace-me
# 未配置 TRANSCRIPTION_API_KEY 时回退使用 OPENAI_API_KEY
OPENAI_API_KEY=replace-me
OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# 1=发送 OpenAI 专属参数(prompt/logprobs)；第三方服务不支持时设为 0
OPENAI_TRANSCRIPTION_EXTRAS=1

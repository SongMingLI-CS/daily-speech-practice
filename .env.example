# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# DeepSeek API
DEEPSEEK_API_KEY=replace-me

# Auth.js / NextAuth.js
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes

# Distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Cloudflare R2 (S3-compatible object storage)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=daily-speech-practice

# OpenAI transcription
OPENAI_API_KEY=replace-me
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
